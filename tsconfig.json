{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "incremental": true,
    // @astrojs/react needs this for the one React island the site still has
    // (components/blog-narrator.tsx). It goes when that island does.
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // lib/ deliberately stays at the repo root rather than moving under src/,
    // so every `@/lib/...` import resolves unchanged and this alias never has
    // to move.
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.tsx", "**/*.astro"],
  // app/ and components/ are the Next implementation, kept on disk purely as a
  // reference to port from. They are not part of the Astro build and are
  // deleted in the final phase; excluding them keeps `astro check` reporting on
  // the Astro side only.
  "exclude": ["node_modules", "dist", ".vercel", "app", "components"]
}
