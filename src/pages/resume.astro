---
import { getProjects, getWorkItems } from "@/lib/content";
import { siteConfig, skills, socialLinks } from "@/lib/config";
import { i18n } from "@/lib/i18n";
import { ogImagePath } from "../lib/og";
import { OG_KEYS } from "../lib/og-cards";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";

const workItems = await getWorkItems();
const allProjects = await getProjects();

// A hand-picked shortlist, kept in this order.
const selectedSlugs = ["scholarian", "mesh-hop", "term-chat", "folio"];
const projects = allProjects
  .filter((p) => selectedSlugs.includes(p.id))
  .sort((a, b) => selectedSlugs.indexOf(a.id) - selectedSlugs.indexOf(b.id));

const socialByBrand = Object.fromEntries(
  socialLinks.map((s) => [s.brand, s.url])
);
const github = socialByBrand["github"];
const linkedin = socialByBrand["linkedin"];

const contactRow =
  "hover:text-foreground -mx-2 flex min-h-9 min-w-0 items-center gap-1.5 rounded px-2 transition-colors min-[540px]:mx-0 min-[540px]:min-h-0 min-[540px]:gap-2 min-[540px]:px-0 print:mx-0 print:min-h-0 print:px-0";
const sectionHeading =
  "text-muted-foreground border-border mb-5 flex items-center gap-2 border-b pb-2 text-xs font-bold tracking-widest uppercase sm:mb-6";
const skillTag =
  "bg-secondary/40 text-foreground rounded px-2 py-0.5 text-xs lowercase";
const skillGroupHeading =
  "text-muted-foreground border-border text-2xs border-b border-dashed pb-1 font-bold tracking-widest uppercase";
---

<Base
  title={i18n.resume.pageTitle}
  description={i18n.resume.summaryContent}
  canonical="/resume"
  ogType="website"
  ogImage={{
    url: ogImagePath(OG_KEYS.resume),
    width: 1200,
    height: 630,
    alt: i18n.resume.pageTitle,
  }}
>
  <div class="mx-auto max-w-3xl min-w-0 pt-2 pb-16 sm:pt-4 sm:pb-20">
    <div
      class="mb-4 flex flex-col items-start justify-between gap-4 sm:mb-8 sm:flex-row sm:items-center sm:gap-6 print:mb-6"
    >
      <div class="min-w-0">
        {
          /* Positive tracking, not negative. Capitals are drawn on a wider
            sidebearing than lowercase and crowd each other at default spacing;
            this was at -0.03em, which tightened them further. Large display
            caps need only a little, hence 0.015em rather than the 0.05–0.1em
            the small uppercase labels below carry. */
        }
        <h1
          class="text-[clamp(1.45rem,8.2vw,2.25rem)] leading-[1.05] font-bold tracking-[0.015em] text-balance uppercase print:text-3xl"
        >
          {siteConfig.person.fullName}
        </h1>
        <p
          class="text-muted-foreground mt-2 text-sm leading-snug font-medium text-pretty sm:text-lg print:text-base"
        >
          {i18n.resume.jobTitle}
        </p>
      </div>

      <div class="flex w-full flex-wrap gap-3 min-[420px]:w-auto print:hidden">
        <button
          type="button"
          data-print
          class="focus-visible:ring-ring bg-secondary hover:bg-secondary/80 inline-flex h-10 w-full items-center justify-center gap-1.5 rounded-md px-3 text-xs leading-none font-medium whitespace-nowrap transition-colors focus-visible:ring-1 focus-visible:outline-none min-[420px]:w-auto"
        >
          <Icon name="download" size={16} />
          {i18n.resume.downloadPdf}
        </button>
      </div>
    </div>

    <div
      class="text-muted-foreground mb-5 grid min-w-0 grid-cols-1 gap-0 text-xs leading-4 min-[540px]:mb-8 min-[540px]:flex min-[540px]:flex-wrap min-[540px]:gap-x-6 min-[540px]:gap-y-2 min-[540px]:text-sm min-[540px]:leading-5 print:mb-6 print:flex print:flex-wrap print:gap-x-6 print:gap-y-2 print:text-xs print:leading-normal"
    >
      <a href={`mailto:${siteConfig.person.email}`} class={contactRow}>
        <Icon name="mail" size={14} class="shrink-0" />
        <span class="wrap-anywhere">{siteConfig.person.email}</span>
      </a>
      {
        linkedin && (
          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class={contactRow}
          >
            <Icon name="linkedin-outline" size={14} class="shrink-0" />
            <span class="wrap-anywhere">linkedin.com/in/swapnoneel</span>
          </a>
        )
      }
      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class={contactRow}
          >
            <Icon name="github-outline" size={14} class="shrink-0" />
            <span class="wrap-anywhere">github.com/Swpn0neel</span>
          </a>
        )
      }
      <a
        href="https://swapnoneel.site"
        target="_blank"
        rel="noopener noreferrer"
        class={contactRow}
      >
        <Icon name="globe" size={14} class="shrink-0" />
        <span class="wrap-anywhere">swapnoneel.site</span>
      </a>
    </div>

    <section class="mb-9 sm:mb-10 print:mb-6">
      <h2
        class="text-muted-foreground border-border mb-4 border-b pb-2 text-xs font-bold tracking-widest uppercase"
      >
        {i18n.resume.summaryHeading}
      </h2>
      <p class="text-muted-foreground text-sm leading-relaxed lowercase">
        {i18n.resume.summaryContent}
      </p>
    </section>

    <section class="mb-10 sm:mb-12 print:mb-8">
      <h2 class={sectionHeading}>
        <Icon name="code-xml" size={14} />
        {i18n.resume.skillsHeading}
      </h2>
      <div
        class="grid grid-cols-1 gap-6 min-[560px]:grid-cols-3 min-[560px]:gap-5 print:gap-4"
      >
        {
          (
            [
              [i18n.resume.skillsCategories.languages, skills.languages],
              [i18n.resume.skillsCategories.frameworks, skills.frameworks],
              [i18n.resume.skillsCategories.tools, skills.tools],
            ] as const
          ).map(([label, list]) => (
            <div class="space-y-3">
              <h3 class={skillGroupHeading}>{label}</h3>
              <div class="flex flex-wrap gap-1.5">
                {list.map((skill) => (
                  <span class={skillTag}>{skill}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <div
      class="grid min-w-0 grid-cols-1 gap-10 md:grid-cols-3 print:grid-cols-3 print:gap-6"
    >
      <div class="space-y-10 md:col-span-2 print:col-span-2 print:space-y-6">
        <section>
          <h2 class={sectionHeading}>
            <Icon name="briefcase" size={14} />
            {i18n.resume.experienceHeading}
          </h2>
          <div class="space-y-8 print:space-y-4">
            {
              workItems.map((item) => (
                <div class="group min-w-0">
                  <div class="mb-2 flex min-w-0 flex-col items-start gap-1 min-[480px]:flex-row min-[480px]:items-baseline min-[480px]:justify-between min-[480px]:gap-4">
                    <h3 class="min-w-0 text-sm leading-snug font-semibold tracking-wider text-balance uppercase">
                      {item.data.title}
                    </h3>
                    <span class="text-muted-foreground text-2xs shrink-0 font-medium whitespace-nowrap">
                      {item.data.date}
                    </span>
                  </div>
                  {/* Deliberately not `.prose`. That class is the site's
                      article-body rule and it is unlayered, so it outranked the
                      `text-xs` beside it and rendered this blurb at article
                      body size and colour. */}
                  <div class="text-muted-foreground max-w-none space-y-2 text-xs leading-relaxed text-pretty lowercase">
                    <p>{item.data.description}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <section>
          <h2 class={sectionHeading}>
            <Icon name="code-xml" size={14} />
            {i18n.resume.projectsHeading}
          </h2>
          <div
            class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 print:gap-4"
          >
            {
              projects.map((project) => {
                const href = project.data.link;
                const Tag = href ? "a" : "div";
                return (
                  <Tag
                    href={href}
                    target={href ? "_blank" : undefined}
                    rel={href ? "noopener noreferrer" : undefined}
                    class={`group border-border bg-secondary/10 hover:bg-secondary/20 block min-w-0 rounded-md border p-4 transition-colors ${href ? "cursor-pointer" : ""}`}
                  >
                    <h3 class="mb-1 flex min-w-0 items-start justify-between gap-3 text-sm leading-snug font-semibold tracking-wider uppercase">
                      <span class="min-w-0 wrap-anywhere">
                        {project.data.title}
                      </span>
                      {href && (
                        <span class="text-muted-foreground group-hover:text-foreground mt-0.5 shrink-0 transition-colors">
                          <Icon name="external-link" size={12} />
                        </span>
                      )}
                    </h3>
                    <p class="text-muted-foreground line-clamp-3 text-xs leading-relaxed text-pretty lowercase sm:line-clamp-2">
                      {project.data.description}
                    </p>
                  </Tag>
                );
              })
            }
          </div>
        </section>
      </div>

      <div class="space-y-10 print:space-y-6">
        <section>
          <h2 class={sectionHeading}>
            <Icon name="graduation-cap" size={14} />
            {i18n.resume.educationHeading}
          </h2>
          <div class="space-y-6 print:space-y-4">
            {
              i18n.resume.education.map((edu) => (
                <div class="space-y-1">
                  <h3 class="text-sm leading-tight font-semibold tracking-wider uppercase">
                    {edu.school}
                  </h3>
                  <p class="text-muted-foreground text-xs leading-relaxed lowercase">
                    {edu.degree}
                  </p>
                  <p class="text-muted-foreground text-2xs leading-relaxed font-medium lowercase italic">
                    {edu.date} | {edu.result}
                  </p>
                </div>
              ))
            }
          </div>
        </section>

        <section>
          <h2 class={sectionHeading}>
            <Icon name="trophy" size={14} />
            {i18n.resume.achievementsHeading}
          </h2>
          <div class="space-y-3 print:space-y-2">
            {
              i18n.work.achievements.slice(0, 5).map((achievement) => (
                <div class="flex items-start gap-2">
                  <span class="text-muted-foreground mt-0.5 text-xs">-</span>
                  <p class="text-muted-foreground text-xs leading-relaxed text-pretty lowercase">
                    {achievement}
                  </p>
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </div>

    <footer
      class="border-border mt-16 border-t pt-8 text-center sm:mt-20 print:hidden"
    >
      <a
        href="/contact"
        class="focus-visible:ring-ring bg-foreground text-background hover:bg-foreground/90 inline-flex h-11 w-full items-center justify-center gap-2 rounded-md px-6 text-sm leading-none font-medium whitespace-nowrap shadow transition-colors focus-visible:ring-1 focus-visible:outline-none min-[420px]:w-auto"
      >
        {i18n.resume.hireMe}
      </a>
    </footer>
  </div>
</Base>

<script>
  import { onPageLoad } from "../scripts/page-lifecycle";

  onPageLoad(() => {
    document
      .querySelector("[data-print]")
      ?.addEventListener("click", () => window.print());
  });
</script>
