---
import { i18n } from "@/lib/i18n";
import { ogImagePath } from "../lib/og";
import { OG_KEYS } from "../lib/og-cards";
import CalBooking from "../components/CalBooking.astro";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";

const c = i18n.contactPage;

const LIMITS = { name: 100, email: 254, subject: 150, message: 5000 };

const field =
  "border-input focus-visible:ring-ring/40 flex w-full rounded-sm border bg-transparent px-3 py-2 text-sm transition-colors focus-visible:ring-1 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50";
---

<Base
  title={c.title}
  description={c.intro}
  ogImage={{
    url: ogImagePath(OG_KEYS.contact),
    width: 1200,
    height: 630,
    alt: c.title,
  }}
>
  <div class="mx-auto max-w-2xl space-y-8 pb-12">
    <div class="space-y-2">
      <h1 class="text-3xl font-semibold tracking-tight">{c.title}</h1>
      <p class="text-muted-foreground text-sm">{c.intro}</p>
    </div>

    {
      /* noValidate: the browser's own bubbles would otherwise pre-empt this
        form's error reporting for some failures and not others — `required`
        never reaches validate() at all, and `type="email"` waves through `a@b`
        while blocking `abc` with an unstyled popup. One validator, one place
        the result is shown. `type="email"` stays for the keyboard it gets on
        phones. */
    }
    <form novalidate class="space-y-6" data-contact-form>
      <div class="space-y-4">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-1.5">
            <label for="name" class="block text-sm font-medium"
              >{c.labels.name}</label
            >
            <input
              id="name"
              name="name"
              type="text"
              required
              maxlength={LIMITS.name}
              placeholder={c.placeholders.name}
              class={`${field} md:h-10`}
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="email" class="block text-sm font-medium"
              >{c.labels.email}</label
            >
            <input
              id="email"
              name="email"
              type="email"
              required
              maxlength={LIMITS.email}
              placeholder={c.placeholders.email}
              class={`${field} md:h-10`}
            />
          </div>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="subject" class="block text-sm font-medium"
            >{c.labels.subject}</label
          >
          <input
            id="subject"
            name="subject"
            type="text"
            required
            maxlength={LIMITS.subject}
            placeholder={c.placeholders.subject}
            class={`${field} md:h-10`}
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="message" class="block text-sm font-medium"
            >{c.labels.message}</label
          >
          <textarea
            id="message"
            name="message"
            required
            maxlength={LIMITS.message}
            rows="6"
            placeholder={c.placeholders.message}
            class={`${field} resize-y`}></textarea>
        </div>
      </div>

      {
        /* Icon markup for each button state, cloned by the script. Kept in the
          template so the SVGs stay build-time output rather than strings in a
          script. */
      }
      <div hidden data-status-icons>
        <span data-icon="idle"
          ><Icon name="send" class="size-[1em] shrink-0" /></span
        >
        <span data-icon="pending">
          <Icon name="loader" class="size-[1em] shrink-0 animate-spin" />
        </span>
        <span data-icon="success">
          <Icon
            name="circle-check"
            class="size-[1em] shrink-0 text-emerald-400 dark:text-emerald-600"
          />
        </span>
        <span data-icon="error">
          <Icon
            name="circle-alert"
            class="size-[1em] shrink-0 text-red-400 dark:text-red-600"
          />
        </span>
      </div>

      <button
        type="submit"
        data-status-button
        data-measured="false"
        aria-label={c.submit.idle}
        class="bg-foreground text-background focus-visible:ring-ring enabled:hover:bg-foreground/90 relative inline-flex h-9 w-full items-center justify-center overflow-hidden rounded-sm text-sm leading-none font-medium whitespace-nowrap shadow transition-[width,background-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] focus-visible:ring-1 focus-visible:outline-none data-[measured=false]:transition-none sm:w-(--status-button-width,auto)"
      >
      </button>

      <span role="status" aria-live="polite" class="sr-only" data-form-announce
      ></span>
    </form>

    <div class="border-border -mt-2 border-t pt-8">
      <h2 class="mb-2 text-xl font-semibold tracking-tight">
        {c.bookCall.title}
      </h2>
      <p class="text-muted-foreground mb-4 text-sm">{c.bookCall.description}</p>
      <CalBooking />
    </div>
  </div>
</Base>

<script>
  import { initContactForm } from "../scripts/contact-form";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) initContactForm(form);
</script>
