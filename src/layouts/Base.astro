---
import { Font } from "astro:assets";
import { siteConfig } from "@/lib/config";
import { i18n } from "@/lib/i18n";
import { buildPersonSchema } from "@/lib/structured-data";
import { safeJsonLd } from "@/lib/utils";
import BackToTop from "../components/BackToTop.astro";
import Navbar from "../components/Navbar.astro";
import SiteFooterLinks from "../components/SiteFooterLinks.astro";
import { resolveAsset } from "../lib/images";
import { ogImagePath } from "../lib/og";
import { OG_KEYS } from "../lib/og-cards";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Path-only canonical; defaults to the current route. */
  canonical?: string;
  ogImage?: { url: string; width?: number; height?: number; alt?: string };
  ogType?: "website" | "article";
  publishedTime?: string;
}

/**
 * The home card is the default for any page that does not name its own.
 * app/opengraph-image.tsx was picked up by the App Router as the fallback for
 * every route; Astro has no such convention, so without this /404 and
 * /work/others would have shipped with no og:image at all.
 */
const {
  title,
  description = siteConfig.metadata.description,
  canonical,
  ogImage = {
    url: ogImagePath(OG_KEYS.home),
    width: 1200,
    height: 630,
    alt: siteConfig.person.fullName,
  },
  ogType = "website",
  publishedTime,
} = Astro.props;

const SITE = "https://www.swapnoneel.site";
const fullTitle = title
  ? `${title} | ${siteConfig.person.fullName}`
  : siteConfig.person.fullName;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, SITE).href;

// The avatar moved into src/assets so Astro optimises it, which means it is
// emitted with a content hash rather than served from a fixed public path.
// JSON-LD needs an absolute URL, so resolve the built asset here.
const avatar = resolveAsset(siteConfig.images.avatar);
const personImage = avatar ? new URL(avatar.src, SITE).href : undefined;

// Writes the *resolved* theme to data-theme before <body> exists, whether the
// visitor has a saved choice or is on "system". Resolving here rather than
// leaving the attribute off and letting the prefers-color-scheme block in
// global.css handle "system" is what keeps the page internally consistent: the
// media query can only restate the palette, so in the gap before the theme
// script runs, every `dark:` utility and every rule keyed on the attribute
// would still render its light form over an already-dark background — company
// logos un-inverted on black, the profile card resting on the wrong face.
//
// This does not pin the theme. src/scripts/theme-store.ts still owns the
// preference and still rewrites data-theme when the OS flips while "system" is
// selected; the attribute being present up front changes nothing about that.
//
// The storage read is guarded because some privacy modes and embedded browsers
// make localStorage throw, and colorScheme is set alongside so form controls,
// scrollbars and the document canvas agree from the first frame — the CSS says
// the same thing, but only once the stylesheet has parsed.
const THEME_INIT = `(function(){var e=document.documentElement,t=null;try{t=localStorage.getItem("theme")}catch(_){}var d=t==="dark"||(t!=="light"&&window.matchMedia("(prefers-color-scheme: dark)").matches);e.dataset.theme=d?"dark":"light";e.style.colorScheme=d?"dark":"light"})();`;

// Blog prose size (A-/A/A+). Unlike the theme this is a lasting accessibility
// preference, so it lives in localStorage — and it has to be applied before
// first paint or the article visibly resizes under the reader. Keep the scales
// in sync with the font-size toggle.
const PROSE_SCALE_INIT = `(function(){try{var s={sm:0.9,md:1,lg:1.15}[localStorage.getItem("prose-scale")];if(s)document.documentElement.style.setProperty("--prose-scale",s)}catch(e){}})();`;
---

<html lang="en" data-scroll-behavior="smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Gives native controls and the browser canvas both supported schemes;
        CSS narrows this to the active scheme from the first rendered frame. */
    }
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={THEME_INIT} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={siteConfig.images.icon} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.person.fullName} - Blog`}
      href="/feed.xml"
    />

    <Font cssVariable="--font-inter" preload />

    <meta property="og:title" content={title ?? siteConfig.person.fullName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.person.fullName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      ogImage && (
        <meta property="og:image" content={new URL(ogImage.url, SITE).href} />
      )
    }
    {
      ogImage?.width && (
        <meta property="og:image:width" content={String(ogImage.width)} />
      )
    }
    {
      ogImage?.height && (
        <meta property="og:image:height" content={String(ogImage.height)} />
      )
    }
    {ogImage?.alt && <meta property="og:image:alt" content={ogImage.alt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? siteConfig.person.fullName} />
    <meta name="twitter:description" content={description} />
    {
      ogImage && (
        <meta name="twitter:image" content={new URL(ogImage.url, SITE).href} />
      )
    }

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd({
        "@context": "https://schema.org",
        ...buildPersonSchema(personImage),
      })}
    />
  </head>

  <body
    class="bg-background text-foreground min-h-screen font-sans antialiased"
  >
    <script is:inline set:html={PROSE_SCALE_INIT} />

    <a href="#main-content" class="skip-to-content"
      >{i18n.common.skipToContent}</a
    >

    <div class="mx-auto flex min-h-screen max-w-2xl flex-col px-4">
      {
        /* <header>, not a plain div: the page had nav/main/contentinfo
          landmarks but no banner, so landmark-based navigation skipped
          straight past the masthead. Direct child of the layout wrapper (not
          of main/article/section), which is what makes it map to the banner
          role. */
      }
      <header class="print:hidden">
        <Navbar />
      </header>

      {
        /* data-page-transition drives the entrance animation from global.css.
          It runs on first paint on every page, which is the whole point: the
          React version keyed it to a client-side route change, so a direct
          link, a refresh or a new tab never animated at all. */
      }
      <main
        id="main-content"
        tabindex="-1"
        class="flex-1"
        data-page-transition="ready"
      >
        <slot />
      </main>

      <div class="print:hidden">
        <BackToTop />
      </div>

      <footer class="text-muted-foreground mt-8 py-12 text-xs print:hidden">
        <SiteFooterLinks />
        <p>
          © {new Date().getFullYear()}
          {siteConfig.person.fullName}. {i18n.footer.rightsReserved}
        </p>
      </footer>
    </div>
    {
      /* Vercel Web Analytics and Speed Insights. Served by Vercel's own edge
        when the features are enabled on the project, so there is no package to
        bundle and nothing to import — which is also why they are gated on PROD:
        both paths 404 on localhost. This is the piece the @astrojs/vercel
        adapter is carried for. */
    }
    {
      import.meta.env.PROD && (
        <Fragment>
          <script is:inline defer src="/_vercel/insights/script.js" />
          <script is:inline defer src="/_vercel/speed-insights/script.js" />
        </Fragment>
      )
    }
  </body>
</html>
