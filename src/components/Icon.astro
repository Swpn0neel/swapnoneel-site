---
/**
 * The lucide icons the site uses, inlined.
 *
 * lucide-react shipped these as React components, which meant a framework
 * runtime on every page to render a handful of static <path> elements. The
 * geometry below is copied verbatim from lucide-react 1.8.0 (ISC) so the icons
 * are pixel-identical to what the site renders today — same 24x24 viewBox,
 * same round caps and joins, same stroke width.
 */
export type IconName =
  | "sun"
  | "moon"
  | "menu"
  | "x"
  | "arrow-up"
  | "arrow-up-right"
  | "calendar"
  | "trophy"
  | "award"
  | "git-branch"
  | "users"
  | "chart-line"
  | "briefcase"
  | "code-xml"
  | "external-link"
  | "globe"
  | "graduation-cap"
  | "mail"
  | "download"
  | "github-outline"
  | "linkedin-outline"
  | "send"
  | "loader"
  | "circle-check"
  | "circle-alert";

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 24, strokeWidth = 2, class: className = "" } = Astro.props;

/** Path data only; the few icons with circles or rects are handled below. */
const PATHS: Record<IconName, string[]> = {
  sun: [
    "M12 2v2",
    "M12 20v2",
    "m4.93 4.93 1.41 1.41",
    "m17.66 17.66 1.41 1.41",
    "M2 12h2",
    "M20 12h2",
    "m6.34 17.66-1.41 1.41",
    "m19.07 4.93-1.41 1.41",
  ],
  moon: [
    "M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401",
  ],
  menu: ["M4 5h16", "M4 12h16", "M4 19h16"],
  x: ["M18 6 6 18", "m6 6 12 12"],
  "arrow-up": ["m5 12 7-7 7 7", "M12 19V5"],
  // Not a lucide icon: the tilted arrow the project index and overlay share.
  "arrow-up-right": ["M7 7h10v10", "M7 17 17 7"],
  calendar: ["M8 2v4", "M16 2v4", "M3 10h18"],
  trophy: [
    "M10 14.66v1.626a2 2 0 0 1-.976 1.696A5 5 0 0 0 7 21.978",
    "M14 14.66v1.626a2 2 0 0 0 .976 1.696A5 5 0 0 1 17 21.978",
    "M18 9h1.5a1 1 0 0 0 0-5H18",
    "M4 22h16",
    "M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1z",
    "M6 9H4.5a1 1 0 0 1 0-5H6",
  ],
  award: [
    "m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526",
  ],
  "git-branch": ["M15 6a9 9 0 0 0-9 9V3"],
  users: [
    "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2",
    "M16 3.128a4 4 0 0 1 0 7.744",
    "M22 21v-2a4 4 0 0 0-3-3.87",
  ],
  "chart-line": ["M3 3v16a2 2 0 0 0 2 2h16", "m19 9-5 5-4-4-3 3"],
  briefcase: ["M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"],
  "code-xml": ["m18 16 4-4-4-4", "m6 8-4 4 4 4", "m14.5 4-5 16"],
  "external-link": [
    "M15 3h6v6",
    "M10 14 21 3",
    "M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6",
  ],
  globe: ["M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20", "M2 12h20"],
  "graduation-cap": [
    "M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z",
    "M22 10v6",
    "M6 12.5V16a6 3 0 0 0 12 0v-3.5",
  ],
  mail: ["m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"],
  download: [
    "M12 15V3",
    "M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4",
    "m7 10 5 5 5-5",
  ],
  // The stroked variants the resume uses in its contact row — distinct from the
  // filled brand marks in SocialIcon.astro.
  "github-outline": [
    "M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.28 1.15-.28 2.35 0 3.5-.73 1.02-1.08 2.25-1 3.5 0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4",
    "M9 18c-4.51 2-5-2-7-2",
  ],
  "linkedin-outline": [
    "M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z",
  ],
  send: [
    "M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z",
    "m21.854 2.147-10.94 10.939",
  ],
  loader: ["M21 12a9 9 0 1 1-6.219-8.56"],
  "circle-check": ["M21.801 10A10 10 0 1 1 17 3.335", "m9 11 3 3L22 4"],
  "circle-alert": ["M12 8v4", "M12 16h.01"],
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`lucide ${className}`}
  aria-hidden="true"
>
  {name === "sun" && <circle cx="12" cy="12" r="4" />}
  {name === "calendar" && <rect width="18" height="18" x="3" y="4" rx="2" />}
  {name === "award" && <circle cx="12" cy="8" r="6" />}
  {
    name === "git-branch" && (
      <Fragment>
        <circle cx="18" cy="6" r="3" />
        <circle cx="6" cy="18" r="3" />
      </Fragment>
    )
  }
  {name === "users" && <circle cx="9" cy="7" r="4" />}
  {name === "briefcase" && <rect width="20" height="14" x="2" y="6" rx="2" />}
  {name === "globe" && <circle cx="12" cy="12" r="10" />}
  {name === "mail" && <rect x="2" y="4" width="20" height="16" rx="2" />}
  {name === "circle-alert" && <circle cx="12" cy="12" r="10" />}
  {
    name === "linkedin-outline" && (
      <Fragment>
        <rect width="4" height="12" x="2" y="9" />
        <circle cx="4" cy="4" r="2" />
      </Fragment>
    )
  }
  {PATHS[name].map((d) => <path d={d} />)}
</svg>
