---
import { navItems } from "@/lib/config";
import { i18n } from "@/lib/i18n";
import Icon from "./Icon.astro";
import { isActivePath } from "../lib/nav";

const pathname = Astro.url.pathname;
---

<div class="group/nav md:hidden" data-open="false" data-mobile-nav>
  {
    /* Catches clicks outside the panel. Hidden while closed so it cannot
      swallow pointer events from the page underneath. */
  }
  <div id="mobile-menu-overlay" class="fixed inset-0 z-40" hidden></div>

  <button
    type="button"
    data-menu-button
    class="text-muted-foreground hover:text-foreground hover:bg-secondary/50 focus-visible:ring-ring relative z-60 flex items-center justify-center rounded-md p-2 transition-colors duration-300 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
    aria-label={i18n.common.toggleMenu}
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <Icon
      name="menu"
      class="h-4 w-4 scale-100 rotate-0 opacity-100 transition-all duration-300 group-data-[open=true]/nav:scale-0 group-data-[open=true]/nav:rotate-90 group-data-[open=true]/nav:opacity-0"
    />
    <Icon
      name="x"
      class="absolute h-4 w-4 scale-0 -rotate-90 opacity-0 transition-all duration-300 group-data-[open=true]/nav:scale-100 group-data-[open=true]/nav:rotate-0 group-data-[open=true]/nav:opacity-100"
    />
  </button>

  <div
    id="mobile-menu"
    class="bg-background/80 border-border pointer-events-none absolute top-full right-0 left-0 z-50 mt-2 flex origin-top -translate-y-2 scale-y-95 flex-col items-center gap-4 rounded-md border py-4 opacity-0 shadow-lg saturate-160 backdrop-blur-[20px] transition-all duration-300 ease-out group-data-[open=true]/nav:pointer-events-auto group-data-[open=true]/nav:translate-y-0 group-data-[open=true]/nav:scale-y-100 group-data-[open=true]/nav:opacity-100"
    role="dialog"
    aria-modal="true"
    aria-label={i18n.common.navigationMenu}
  >
    {
      navItems.map((item) => {
        const active = isActivePath(pathname, item.href);
        return (
          <a
            data-nav-link
            data-astro-prefetch="viewport"
            data-active={String(active)}
            href={item.href}
            class="hover:text-foreground focus-visible:ring-ring text-muted-foreground data-[active=true]:text-foreground/80 w-full rounded-md py-2 text-center text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
            aria-current={active ? "page" : undefined}
          >
            {i18n.nav[item.key]}
          </a>
        );
      })
    }
  </div>
</div>

<script>
  import { onPageLoad } from "../scripts/page-lifecycle";
  import { initMobileNav } from "../scripts/mobile-nav";

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>("[data-mobile-nav]");
    if (root) initMobileNav(root);
  });
</script>
