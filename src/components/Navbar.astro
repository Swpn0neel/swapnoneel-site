---
import { navItems, siteConfig } from "@/lib/config";
import { i18n } from "@/lib/i18n";
import { isActivePath } from "../lib/nav";
import MobileNav from "./MobileNav.astro";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;

/* The Next version passed `prefetch={false}` on the home link when already on
   the home page, because Next spent ~28 KiB prefetching a route the visitor
   was standing on. Plain anchors do not prefetch, so there is nothing to
   suppress. */
---

<nav
  class="relative mb-4 flex items-center justify-between py-6"
  aria-label={i18n.common.mainNavigation}
>
  <a
    href="/"
    class="text-foreground hover:border-border border-b border-transparent text-sm font-medium transition-opacity duration-300 hover:opacity-60"
  >
    {siteConfig.person.shortName}
  </a>
  <div class="flex items-center gap-6">
    <div class="hidden items-center gap-6 md:flex">
      {
        navItems.map((item) => {
          const active = isActivePath(pathname, item.href);
          return (
            <a
              data-nav-link
              data-active={String(active)}
              href={item.href}
              class="hover:text-foreground focus-visible:ring-ring text-muted-foreground data-[active=true]:text-foreground/90 rounded-sm text-sm transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
              aria-current={active ? "page" : undefined}
            >
              {i18n.nav[item.key]}
            </a>
          );
        })
      }
    </div>
    <div class="flex items-center gap-2">
      <ThemeToggle />
      <MobileNav />
    </div>
  </div>
</nav>

<script>
  import { onPageLoad } from "../scripts/page-lifecycle";
  import { isActivePath } from "../lib/nav";

  /**
   * The header is transition:persist'd, so it is never re-rendered and its
   * server-computed aria-current would stay pinned to whichever page was
   * loaded first. Re-marking it here is the cost of keeping the node — worth
   * paying, because persisting is also what keeps the theme toggle's and mobile
   * nav's listeners valid across navigations.
   */
  onPageLoad(() => {
    const path = window.location.pathname;
    for (const link of document.querySelectorAll<HTMLAnchorElement>(
      "[data-nav-link]"
    )) {
      const href = link.getAttribute("href");
      if (!href) continue;
      const active = isActivePath(path, href);
      if (active) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
      link.dataset.active = String(active);
    }
  });
</script>
