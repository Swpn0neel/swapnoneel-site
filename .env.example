# ── Required on Vercel ────────────────────────────────────────────────
# Astro exposes only PUBLIC_-prefixed vars to the browser. These three are
# read by the contact form (src/scripts/contact-form.ts); without them it
# reports "not configured" and sends nothing.
PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ── Local only ────────────────────────────────────────────────────────
# Used by scripts/generate-narrations.mjs to upload MP3s to Vercel Blob.
# That script no-ops on Vercel's builder (it checks process.env.VERCEL), so
# this does NOT need to be set on the deployment — narration manifests are
# committed by the pre-commit hook and the build just reads them.
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token
